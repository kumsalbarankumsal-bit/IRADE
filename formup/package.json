{
  "name": "formup",
  "version": "2.0.0",
  "private": true,
  "description": "FormUp — IB Math AA SL ve temel matematik formüllerini aralıklı tekrarla, oyunlaştırılmış ve iki dilli (Türkçe + İngilizce) öğrenme uygulaması",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
