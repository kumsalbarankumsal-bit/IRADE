    "smoke": "node scripts/build.mjs && node scripts/smoke.mjs",
    "lab": "node scripts/lab-preview.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "katex": "0.16.9",
    "lucide-react": "0.468.0",
    "playwright-core": "^1.56.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
